# Server-side env file for docker-compose.prod.yml.
#
# Copy this to `.env` in the SAME directory as docker-compose.prod.yml on the
# server (~/kumbuka-deploy/.env) and fill in real values. This file is never
# committed or deployed by CI — it's created once, by hand, on the server,
# and the deploy workflow leaves it untouched on every subsequent deploy.
#
# DB_ENGINE / DB_HOST / DB_PORT are NOT listed here — docker-compose.prod.yml
# sets those directly (DB_HOST must always be `db`, the compose service name).

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
# Backend is reached through Caddy at kumbukabackend.tarxemo.com (-> 127.0.0.1:8032)
DJANGO_ALLOWED_HOSTS=kumbukabackend.tarxemo.com
# The frontend's public origin (https, since Caddy terminates TLS)
CORS_ALLOWED_ORIGINS=https://kumbuka.tarxemo.com
# For the Django admin login at https://kumbukabackend.tarxemo.com/admin/
CSRF_TRUSTED_ORIGINS=https://kumbukabackend.tarxemo.com
TIME_ZONE=Africa/Dar_es_Salaam
TOKEN_TTL_DAYS=30

# --- Postgres (used by both the db and backend containers) ---
DB_NAME=kumbuka
DB_USER=kumbuka
DB_PASSWORD=replace-with-a-strong-password
